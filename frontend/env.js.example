/**
 * frontend/env.js — browser-side environment variables.
 *
 * HOW TO USE THIS FILE
 *   1. Copy this file to `frontend/env.js`
 *        Windows:    copy frontend\env.js.example frontend\env.js
 *        Mac/Linux:  cp frontend/env.js.example frontend/env.js
 *   2. Fill in the values from your root `.env` (the ones you put in
 *      step 2a of SETUP_CHECKLIST.md). The Turso + Squad keys appear
 *      in BOTH places: `.env` is read by the AI engine container,
 *      `frontend/env.js` is read by the browser. Yes, that means
 *      pasting the same value twice — the Squad public key is the
 *      only one the browser strictly needs, but the rest are kept
 *      for parity so the UI can talk to Turso directly over HTTP.
 *   3. After editing, restart the frontend container so nginx picks
 *      up the new file:
 *        docker compose restart frontend
 *
 * `frontend/env.js` is gitignored. Never commit real keys.
 */
window.ENV = {
  // -------- Turso (database) --------
  // From your Turso dashboard. The browser talks to libSQL over HTTP.
  TURSO_DATABASE_URL: 'libsql://your-database-name.turso.io',
  TURSO_AUTH_TOKEN:   'eyJhbGciOi...your-jwt-token...',

  // -------- Squad (payments) --------
  // Sandbox keys are fine for local dev.
  SQUAD_SECRET_KEY:   'sandbox_sk_your-secret-key',
  SQUAD_PUBLIC_KEY:   'sandbox_pk_your-public-key',
  SQUAD_MERCHANT_ID:  'your-squad-merchant-id',
  SQUAD_ENVIRONMENT:  'sandbox',

  // -------- AI Risk Engine --------
  // The browser reaches the Flask container via the host port mapping.
  // Leave this as `http://localhost:5000` when running with the
  // bundled docker-compose stack.
  AI_ENGINE_URL:      'http://localhost:5000',

  // -------- Holding account (Squad virtual account) --------
  // The single virtual account where buyer funds sit while in escrow.
  HOLDING_ACCOUNT:    '0123456789'
};
