# Environment Variables for ScrowPay
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it's in .gitignore

# ============================================
# Turso Database Configuration
# ============================================
# Get these from: https://turso.tech/
# 1. Create a database in Turso dashboard
# 2. Copy the database URL (format: libsql://your-db-name.turso.io)
# 3. Generate an auth token from the database settings
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ============================================
# Squad API Configuration
# ============================================
# Get these from: https://squadco.com/
# Sandbox credentials (for testing and development)
SQUAD_SECRET_KEY=sandbox_sk_your-secret-key-here
SQUAD_PUBLIC_KEY=sandbox_pk_your-public-key-here
SQUAD_ENVIRONMENT=sandbox

# Production credentials (uncomment when ready for production)
# SQUAD_SECRET_KEY=sk_your-production-secret-key-here
# SQUAD_PUBLIC_KEY=pk_your-production-public-key-here
# SQUAD_ENVIRONMENT=production

# ============================================
# AI Risk Engine Configuration
# ============================================
# URL of the AI Risk Engine microservice
# Local development: http://localhost:5000
# Docker: http://ai-engine:5000 (when using docker-compose)
# Production: https://your-ai-engine-domain.com
AI_ENGINE_URL=http://localhost:5000

# ============================================
# Holding Account Configuration
# ============================================
# Squad virtual account number for holding escrow funds
# This account temporarily holds funds during transactions
# Get this from Squad dashboard after creating a holding account
HOLDING_ACCOUNT=your-holding-account-number-here

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file: 
#    Windows: copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
# 2. Replace all placeholder values with your actual credentials
#
# 3. Never commit .env to git (it's already in .gitignore)
#
# 4. For team members: Get credentials from your team lead or project documentation

# ============================================
# Getting Your Credentials
# ============================================
# 
# TURSO DATABASE:
# 1. Sign up at https://turso.tech/
# 2. Create a new database
# 3. Copy the database URL from the dashboard
# 4. Generate an auth token in database settings
#
# SQUAD API:
# 1. Sign up at https://squadco.com/
# 2. Go to API Keys section in dashboard
# 3. Copy your sandbox keys for testing
# 4. For production, request production keys from Squad
#
# HOLDING ACCOUNT:
# 1. Create a virtual account in Squad dashboard
# 2. Label it as "Escrow Holding Account"
# 3. Copy the account number
# 4. This account will hold funds during escrow transactions

# ============================================
# Deployment Notes
# ============================================
# 
# For Vercel/Netlify deployment:
# 1. Go to your project settings
# 2. Navigate to Environment Variables
# 3. Add each variable above with its actual value
# 4. Redeploy your application
#
# For Docker deployment:
# 1. Update this .env file with actual values
# 2. Docker Compose will automatically load these variables
# 3. Run: docker-compose up -d
#
# Security Notes:
# - Never commit .env to version control
# - Use different credentials for development and production
# - Rotate credentials regularly
# - Keep Squad secret keys confidential

